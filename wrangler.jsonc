{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cozy-vibes",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "HOUSES", "class_name": "House" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["House"] }]
}
